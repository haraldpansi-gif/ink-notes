[Desktop Entry]
Version=1.0
Name=ink-notes
GenericName=Note-Taking & Inking App
GenericName[de]=Notizbuch- & Inking-App
Comment=Handwritten notes with pen, touch and mouse; annotate PDFs
Comment[de]=Handschriftliche Notizen mit Stift, Touch und Maus; PDFs beschriften
Exec=ink-notes %F
Icon=eu.pansi.ink-notes
Terminal=false
Type=Application
Categories=Office;Graphics;
Keywords=Note;Pen;Ink;Inking;Stylus;Drawing;PDF;Vector;Text;Annotation;
Keywords[de]=Notiz;Stift;Ink;Inking;Stylus;Zeichnen;PDF;Vektor;Text;Annotation;
StartupWMClass=eu.pansi.ink-notes
MimeType=application/x-inknotes;
Actions=NewWindow;

[Desktop Action NewWindow]
Name=New Window
Name[de]=Neues Fenster
Exec=ink-notes
